spring.application.name=EZStockApi

spring.datasource.url=jdbc:mysql://localhost:3306/ezstock?serverTimezone=Asia/Taipei
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

finmind.api.url=https://api.finmindtrade.com/api/v4/data
finmind.api.token=YOUR_FINMIND_TOKEN

# ---------- DAO 實作切換：jpa 或 mybatis ----------
ezstock.dao.type=jpa

# ---------- MyBatis ----------
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.ezstock.model

# ---------- Log ----------
# 自己的程式：DEBUG 以上都印（含 MyBatis 執行的 SQL 與參數）
logging.level.com.ezstock=DEBUG
# JPA / Hibernate 執行的 SQL 與參數
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.orm.jdbc.bind=TRACE
# 同時寫進檔案，位置在 EZStockApi/logs/ezstock.log
logging.file.name=logs/ezstock.log

# ---------- 匯入 ----------
# 要匯入價格與股利的股票（股票清單一律匯入全部上市股票與 ETF）
ezstock.import.stock-ids=2330,2317,2454,2303,2412,2882,2891,0050,0056,00878
ezstock.import.years=5
# true：啟動時自動匯入一次（匯入完記得改回 false）
ezstock.import.run-on-startup=false
